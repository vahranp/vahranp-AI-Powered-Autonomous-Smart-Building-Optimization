OLLAMA_MODEL=llama3.1:8b

# Adaptive LLM invocation (see sim/energyplus_loop.py's "llm" strategy
# docstring) -- the strategic layer is event-driven, not called every tick.
# LLM_MAX_INVOCATIONS caps total real calls for the whole run; raised to 45
# so the LLM can genuinely cover a large share of occupied-zone decisions
# instead of being budget-limited -- an explicit tradeoff accepted in
# exchange for far less reactive-fallback dilution.
LLM_MAX_INVOCATIONS=45
# 16, not 8 -- 8 was smaller than the ~4-6 ticks a single invocation's own
# compute consumes while paced, so heartbeat alone nearly re-fired the
# moment the previous invocation finished, leaving almost no genuinely fast
# (unpaced) stretch between invocations. 16 leaves real breathing room for
# fast ticks while still refreshing regularly when nothing more urgent fires.
LLM_HEARTBEAT_TICKS=16
# 4, not 1 -- 1 was trivially already satisfied by the time a typical
# invocation's own compute window finished, so it imposed no real gap.
LLM_MIN_COOLDOWN_TICKS=4
# The actual bottleneck on coverage: only one invocation can be in flight at
# a time, so how many fit in a run is (occupied_ticks x LLM_TICK_PACING_S) /
# invocation_latency, not the budget above. 15s/tick measured only ~4-6
# invocations fitting regardless of budget/heartbeat; raised to 40s so ~15-20+
# fit. Direct cost: a 100-tick run's wall-clock floor goes from ~25 to ~67 min.
LLM_TICK_PACING_S=40
MAX_SIM_TICKS=100
